# CareerLens AI - environment variables.
# Copy to `.env` (never commit it). On Vercel, set the same names in
# Project -> Settings -> Environment Variables. All values below are placeholders.

# ---- Backend runtime -------------------------------------------------------
# development | production. Production enforces stricter checks (secure cookies, no debug).
APP_ENV=development

# Postgres connection string. postgres:// and postgresql:// are accepted; the backend rewrites
# them to postgresql+psycopg://. On Neon use the POOLED connection string (host contains "-pooler")
# and keep ?sslmode=require.
DATABASE_URL=postgresql://careerlens:careerlens@localhost:5432/careerlens

# Signing key for JWTs, at least 32 characters. Generate one:
#   bash/zsh:    python -c "import secrets;print(secrets.token_urlsafe(48))"
#   PowerShell:  python -c "import secrets;print(secrets.token_urlsafe(48))"
#   or:          ./infrastructure/scripts/generate-secret.ps1   (Windows)
#                ./infrastructure/scripts/generate-secret.sh    (Linux/macOS)
JWT_SECRET=change-me-generate-a-random-value-of-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated allowed browser origins. Leave EMPTY for a same-origin deployment (Vercel, nginx).
# Local Vite dev server example: http://localhost:5173
CORS_ORIGINS=

# Public base URL of the app; used to build password-reset links.
APP_BASE_URL=http://localhost:5173

# Maximum resume upload size in MB. Keep <= 4 on Vercel (4.5 MB request body limit).
MAX_UPLOAD_MB=4

# Optional: transactional email through Resend. Without both values, forgot-password
# emails are NOT sent (the endpoint still answers 202).
RESEND_API_KEY=
EMAIL_FROM=

# Optional OCR for scanned PDFs. Requires Tesseract (Docker: build with INSTALL_OCR=true).
OCR_ENABLED=false

# Optional LLM provider abstraction. Unused by default; the core product works without it.
LLM_PROVIDER=none
LLM_API_KEY=

# ---- Frontend (build time) ---------------------------------------------------
VITE_API_BASE_URL=/api/v1

# ---- Docker Compose only -----------------------------------------------------
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=careerlens
# docker-compose.prod.yml: image owner/tag on GHCR (lowercase) and published port.
GITHUB_REPOSITORY_OWNER=your-github-username
IMAGE_TAG=latest
WEB_PORT=8080

# ---- Tests (optional) ----------------------------------------------------------
# Run the backend suite against Postgres instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql://careerlens:careerlens@localhost:5432/careerlens_test
