# Used because the build context is the repository root (BuildKit picks up
# <Dockerfile>.dockerignore next to the Dockerfile).
**
!requirements.txt
!backend/
!infrastructure/scripts/backend-entrypoint.sh
backend/.venv
backend/tests
backend/**/__pycache__
backend/.pytest_cache
backend/.ruff_cache
backend/.env
backend/.coverage
backend/coverage.xml
backend/htmlcov
